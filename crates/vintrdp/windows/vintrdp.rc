// The application icon, manifest and version (Properties > Details in Explorer).
// version.h is written by build.rs: the version, and its numeric X,Y,N,0 form.
#include "version.h"

1 ICON "assets/icon.ico"
1 24 "windows/vintrdp.manifest"

1 VERSIONINFO
FILEVERSION VINTRDP_FILE_VERSION
PRODUCTVERSION VINTRDP_FILE_VERSION
FILEFLAGSMASK 0x3f
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Dani Sarfati"
            VALUE "FileDescription", "vintrdp"
            VALUE "FileVersion", VINTRDP_VERSION_TEXT
            VALUE "InternalName", "vintrdp"
            VALUE "LegalCopyright", "GNU GPL version 3 or later"
            VALUE "OriginalFilename", "vintrdp.exe"
            VALUE "ProductName", "vintrdp"
            VALUE "ProductVersion", VINTRDP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
