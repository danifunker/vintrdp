diff -ruN a/gnutls-3.8.13/lib/nettle/sysrng-windows.c b/gnutls-3.8.13/lib/nettle/sysrng-windows.c
--- a/gnutls-3.8.13/lib/nettle/sysrng-windows.c
+++ b/gnutls-3.8.13/lib/nettle/sysrng-windows.c
@@ -50,6 +50,31 @@
 
 get_entropy_func _rnd_get_system_entropy = NULL;
 
+#if defined(_WIN32_WINNT) && _WIN32_WINNT < 0x0500
+/* Windows NT 4.0: RtlGenRandom (advapi32's SystemFunction036 of Windows XP), which
+   ruststdwinnt4's nt4compat gives programs on NT 4.0 (entropy gathered in software: PINT
+   has no CryptGenRandom). */
+__declspec(dllimport) BOOLEAN WINAPI SystemFunction036(PVOID buffer, ULONG length);
+
+static int _rnd_get_system_entropy_win32(void *rnd, size_t size)
+{
+	if (!SystemFunction036(rnd, (ULONG)size)) {
+		_gnutls_debug_log("Error in RtlGenRandom\n");
+		return GNUTLS_E_RANDOM_DEVICE_ERROR;
+	}
+	return 0;
+}
+
+int _rnd_system_entropy_init(void)
+{
+	_rnd_get_system_entropy = _rnd_get_system_entropy_win32;
+	return 0;
+}
+
+void _rnd_system_entropy_deinit(void)
+{
+}
+#else
 static HCRYPTPROV device_fd = 0;
 
 static int _rnd_get_system_entropy_win32(void *rnd, size_t size)
@@ -79,3 +104,4 @@
 {
 	CryptReleaseContext(device_fd, 0);
 }
+#endif
